{
  "name": "restclient-net-website",
  "version": "1.0.0",
  "description": "RestClient.Net documentation website",
  "type": "module",
  "scripts": {
    "generate-api": "node scripts/generate-api-docs.js",
    "dev": "npm run generate-api && eleventy --serve --port=4173",
    "build": "npm run generate-api && npm run clean && eleventy && node scripts/check-site.js",
    "test:unit": "node --test --test-concurrency=1 tests-node/*.test.js",
    "test": "playwright test",
    "clean": "node -e \"require('node:fs').rmSync('_site', {recursive: true, force: true})\""
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@playwright/test": "^1.63.0",
    "acorn": "8.18.0",
    "parse5": "8.0.1"
  },
  "dependencies": {
    "@11ty/eleventy-plugin-syntaxhighlight": "5.0.2",
    "markdown-it": "14.3.2",
    "markdown-it-anchor": "9.2.0"
  }
}
