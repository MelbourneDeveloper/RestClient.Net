<section><p class="eyebrow">RESTCLIENT.NET / JOURNAL</p><h1>博客</h1><p>类型、工具与更可靠的软件。</p><div class="grid">{% for post in collections.zhposts %}<article class="feature-card"><small>{{ post.date | dateFormat }} · {{ post.data.author }}</small><h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2><p>{{ post.data.excerpt or post.data.description }}</p><a href="{{ post.url }}">阅读全文 ↗</a></article>{% endfor %}</div></section>
